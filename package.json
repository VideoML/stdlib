{
  "name": "@videoml/stdlib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom/index.ts",
    "./react": "./src/react/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./catalog": "./catalog/manifest.json",
    "./catalog/schema": "./catalog/schema.json",
    "./effects": "./src/effects/index.ts",
    "./demos": "./src/demos/index.ts",
    "./effects/particles": "./src/effects/particles/index.ts",
    "./effects/echo-smear": "./src/effects/echo-smear/index.ts",
    "./effects/transitions": "./src/effects/transitions/index.ts",
    "./effects/xml": "./src/effects/xml.ts",
    "./effects/catalog-c001": "./src/effects/catalog-c001/index.ts"
  },
  "scripts": {
    "test:catalog": "node --test tests/catalog.test.mjs",
    "test:particles": "node --import tsx --test tests/particles.test.mjs",
    "test:particles:browser": "node --test tests/particles-browser.test.mjs",
    "test:echo-smear": "node --import tsx --test tests/echo-smear.test.mjs",
    "test:echo-smear:browser": "node --test tests/echo-smear-browser.test.mjs",
    "test:echo-smear:dom-browser": "node --test tests/echo-smear-dom-browser.test.mjs",
    "test:echo-smear:reference": "node --test tests/echo-smear-reference-browser.test.mjs",
    "test:transitions": "node --import tsx --test tests/transitions/*.test.mjs",
    "test:xml-effects": "node --import tsx --test tests/xml-effects/*.test.mjs",
    "test:catalog-c001": "node --import tsx --test tests/catalog-c001/registry.test.mjs tests/catalog-c001/ascii-pass.test.mjs",
    "test:catalog-c001:browser": "node --test tests/catalog-c001/browser.test.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "animejs": "4.5.0",
    "three": "0.163.0",
    "d3": "7.9.0",
    "lottie-web": "5.13.0",
    "p5": "1.11.13",
    "framer-motion": "11.18.2",
    "gsap": "3.15.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "license": "MIT",
  "devDependencies": {
    "tsx": "4.19.2"
  }
}
